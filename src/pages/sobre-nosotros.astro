---
import Layout from "../layouts/Layout.astro";

const consejeros = [
  { nombre: "Exy Garay Pereira", cargo: "Consejera Superior", facultad: "Ingeniería Civil", imagen: "/exy.jpeg" },
  { nombre: "Dora Gárate", cargo: "Sub Consejera Superior", facultad: "Letras Hispánicas", imagen: "/dora.jpeg" },
  { nombre: "Constanza Inostroza", cargo: "Coordinadora General", facultad: "Periodismo", imagen: "/coni.jpeg" },
  { nombre: "Isabella Cherubini", cargo: "Coordinadora General", facultad: "Ingeniería Civil", imagen: "/isa.jpg" },
  { nombre: "Ignacio Laval", cargo: "Secretario General", facultad: "Ingeniería Civil", imagen: "/nacho.png" },
  { nombre: "Renzo Porcile", cargo: "Coordinador Político", facultad: "Derecho", imagen: "/renzo.jpeg" },
  { nombre: "Paz Burckhardt", cargo: "Coordinadora Comunicaciones", facultad: "Periodismo/College", imagen: "/pachu.jpeg" },
  { nombre: "Victoria Muñoz Boitano", cargo: "Coordinadora Comunicaciones", facultad: "Periodismo", imagen: "/vicky.jpeg" },
  { nombre: "María José Fuenzalida", cargo: "Coordinadora Logística", facultad: "Sociología/College", imagen: "/cote.png" },
  { nombre: "Florencia Osses", cargo: "Coordinadora Logística", facultad: "Derecho", imagen: "/flo.jpeg" },
  { nombre: "Fabio Condori Tembladera", cargo: "Coordinador Logística", facultad: "LICC", imagen: "/fabio.jpeg" },
  { nombre: "Tomás Mendoza", cargo: "Coordinador Logística", facultad: "Agronomía", imagen: "/galleta.jpeg" },
  { nombre: "Tomás Elliott Carvallo", cargo: "Coordinador Logística", facultad: "Administración Pública", imagen: "/tomas.jpeg" },
  { nombre: "Sofía Aguilera", cargo: "Coordinadora San Joaquín", facultad: "Administración Pública", imagen: "/sofia.jpeg" },
  { nombre: "Amelia Galilea", cargo: "Coordinadora San Joaquín", facultad: "Antropología", imagen: "/ame.jpg" },
  { nombre: "Sofía Contreras", cargo: "Coordinadora Casa Central", facultad: "Periodismo", imagen: "/sofic.jpeg" },
  { nombre: "Joaquín Cruz", cargo: "Coordinador Casa Central", facultad: "Publicidad", imagen: "/joaco.png" },
  { nombre: "Benjamín Rodriguez", cargo: "Coordinador Lo Contador", facultad: "Arquitectura", imagen: "/benja.jpeg" },
  { nombre: "Joel Aguilera Flores", cargo: "Coordinador Lo Contador", facultad: "Arquitectura", imagen: "/joel.jpeg" },
  { nombre: "Agustín Dominguez", cargo: "Coordinador Oriente", facultad: "Música/College", imagen: "/agus.JPEG" },
];
---

<Layout title="Sobre Nosotros" description="Conoce quiénes somos y qué hacemos en la Consejería Superior UC.">

  <!-- Page header -->
  <section class="py-16 px-4 text-white text-center" style="background: linear-gradient(135deg, #364FAB 0%, #8452B1 100%);">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-3xl md:text-5xl font-bold mb-4">Sobre Nosotros</h1>
      <p class="text-white/80 text-lg">Conoce quiénes somos, qué hacemos y por qué lo hacemos.</p>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-4 py-16 space-y-16">

    <!-- Quiénes somos -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <div class="w-1 h-8 rounded-full" style="background: #2272BC;"></div>
        <h2 class="text-2xl font-bold" style="color: #364FAB;">¿Quiénes somos?</h2>
      </div>
      <div class="prose prose-gray max-w-none text-gray-600 leading-relaxed space-y-4">
        <p>
          La Consejería Superior es el espacio máximo de representación académica de los estudiantes de la UC
        </p>
        <p>
          Es electa democráticamente por los estudiantes y tiene como misión velar por los estudiantes de toda la UC
        </p>
      </div>
    </section>

    <!-- Misión -->
    <section class="rounded-2xl p-8" style="background: linear-gradient(135deg, #EEF4FB, #F5EFF9);">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-1 h-8 rounded-full" style="background: #8452B1;"></div>
        <h2 class="text-2xl font-bold" style="color: #8452B1;">Nuestra Misión</h2>
      </div>
      <p class="text-gray-600 leading-relaxed">
        Representar a los estudiantes de la UC con transparencia, compromiso y trabajo colectivo, asegurando que su voz esté presente en las decisiones que marcan el rumbo de la universidad.
      </p>
    </section>

    <!-- Qué hacemos -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <div class="w-1 h-8 rounded-full" style="background: #BF7CF9;"></div>
        <h2 class="text-2xl font-bold" style="color: #364FAB;">¿Qué hacemos?</h2>
      </div>
      <ul class="grid sm:grid-cols-2 gap-4">
        {[
          "Participamos con derecho a voz en el Consejo Superior.",
          "Representamos a todos los estudiantes de pregrado",
          "Realizamos actividades de apoyo académico y espacios de distención",
          "Difundimos información relevante de manera oportuna y transparente.",
          "Trabajamos junto a otras instancias de representación estudiantil.",
          "Elaboramos propuestas e iniciativas en favor del estudiantado.",
        ].map((item) => (
          <li class="flex items-start gap-3 p-4 rounded-xl bg-white border border-gray-100 shadow-sm">
            <span class="mt-0.5 flex-shrink-0 w-5 h-5 rounded-full flex items-center justify-center text-white text-xs font-bold" style="background: #BF7CF9;">✓</span>
            <span class="text-gray-600 text-sm leading-relaxed">{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Consejeros -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <div class="w-1 h-8 rounded-full" style="background: #2272BC;"></div>
        <h2 class="text-2xl font-bold" style="color: #364FAB;">Consejería Superior</h2>
      </div>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
        {consejeros.map(({ nombre, cargo, facultad, imagen }) => (
          <div class="rounded-2xl p-5 border border-gray-100 shadow-sm bg-white text-center">
            {imagen ? (
              <img src={imagen} alt={nombre} class="w-16 h-16 rounded-full mx-auto mb-3 object-cover" />
            ) : (
              <div class="w-16 h-16 rounded-full mx-auto mb-3 flex items-center justify-center text-white text-xl font-bold" style="background: linear-gradient(135deg, #364FAB, #8452B1);">
                {nombre.charAt(0)}
              </div>
            )}

            <p class="font-semibold text-gray-800 text-sm">{nombre}</p>
            <p class="text-xs mt-1 font-medium" style="color: #8452B1;">{cargo}</p>
            <p class="text-xs text-gray-400 mt-0.5">{facultad}</p>
          </div>
        ))}
      </div>
    </section>

  </div>
</Layout>
