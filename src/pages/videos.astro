---
import Layout from "../layouts/Layout.astro";
import videos from "../data/videos.json";
---

<Layout title="Videos" description="Mira las sesiones y contenido audiovisual de la Consejería Superior UC.">

  <!-- Page header -->
  <section class="py-16 px-4 text-white text-center" style="background: linear-gradient(135deg, #364FAB 0%, #8452B1 100%);">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-3xl md:text-5xl font-bold mb-4">Videos</h1>
      <p class="text-white/80 text-lg">Cápsulas y Podcasts en YouTube.</p>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 py-16 space-y-14">
    {videos.map(({ categoria, items }) => (
      <section>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-1 h-7 rounded-full" style="background: #BF7CF9;"></div>
          <h2 class="text-xl font-bold" style="color: #364FAB;">{categoria}</h2>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          {items.map(({ titulo, descripcion, youtubeId, firstVideoId, tipo }) => {
            const embedSrc = tipo === "playlist"
              ? `https://www.youtube.com/embed/${firstVideoId}?list=${youtubeId}`
              : `https://www.youtube.com/embed/${youtubeId}`;

            return (
              <div class="rounded-2xl overflow-hidden border border-gray-100 shadow-sm bg-white hover:shadow-md transition-shadow">
                <!-- Embed -->
                <div class="relative w-full" style="padding-top: 56.25%;">
                  <iframe
                    src={embedSrc}
                    title={titulo}
                    class="absolute inset-0 w-full h-full"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    loading="lazy"
                  />
                </div>

                <!-- Info -->
                <div class="p-4">
                  <div class="flex items-start justify-between gap-2">
                    <div>
                      <p class="font-semibold text-gray-800 leading-snug">{titulo}</p>
                      {descripcion && (
                        <p class="text-gray-500 text-sm mt-1">{descripcion}</p>
                      )}
                    </div>
                    <span class="flex-shrink-0 px-2 py-0.5 rounded-full text-xs font-semibold text-white mt-0.5"
                      style={tipo === "playlist" ? "background: #8452B1;" : "background: #2272BC;"}>
                      {tipo === "playlist" ? "Playlist" : "Video"}
                    </span>
                  </div>

                  <a
                    href={tipo === "playlist"
                      ? `https://www.youtube.com/playlist?list=${youtubeId}`
                      : `https://www.youtube.com/watch?v=${youtubeId}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 mt-3 text-xs font-semibold hover:underline transition-colors"
                    style="color: #8452B1;"
                  >
                    Ver en YouTube
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</Layout>
