---
import Layout from "../layouts/Layout.astro";

const temaColor: Record<string, string> = {
  "Salud Física":     "#EF4444",
  "Salud Mental":     "#8452B1",
  "Seguridad":        "#EA580C",
  "Convivencia":      "#2272BC",
  "Bienestar":        "#EC4899",
  "Normativas":       "#6B7280",
  "Salud General":    "#EF4444",
  "Académico":        "#364FAB",
  "Socioeconómico":   "#16A34A",
};

const urgentes = [
  {
    tema: "Salud Física",
    situacion: "¿Necesitas apoyo urgente en salud física?",
    servicio: "UC Emergencias",
    contacto: ["Anexos UC: 5000", "Celular: +56 955045000"],
    url: "https://www.uc.cl/emergencias",
  },
  {
    tema: "Salud Mental",
    situacion: "¿Estás en una crisis o emergencia de salud mental?",
    servicio: "UC Emergencias + Línea *4141",
    contacto: ["Anexos UC: 5000", "Celular: +56 955045000", "Fuera del campus: *4141 (24/7, gratuita)"],
    url: "https://www.uc.cl/emergencias",
  },
  {
    tema: "Seguridad",
    situacion: "¿Necesitas apoyo urgente en seguridad o infraestructura dentro del campus?",
    servicio: "UC Emergencias",
    contacto: ["Anexos UC: 5000", "Celular: +56 955045000"],
    url: "https://www.uc.cl/emergencias",
  },
];

const otras = [
  {
    tema: "Convivencia",
    situacion: "¿Necesitas apoyo en conflictos con compañeros, profesores u otros funcionarios?",
    servicio: "Ombuds y Mediadora Estudiantil",
    contacto: ["(56) 22354169 / (56) 223541247", "+569 63661976", "Edificio Pataguas -1, Campus San Joaquín"],
    url: "https://ombuds.uc.cl/",
  },
  {
    tema: "Bienestar",
    situacion: "¿Necesitas información o apoyo en temas de violencia sexual?",
    servicio: "UVG",
    contacto: ["uvg@uc.cl", "Fonoayuda UC: 800 001 222"],
    url: "https://noviolenciaydiscriminacion.uc.cl/",
  },
  {
    tema: "Normativas",
    situacion: "¿Necesitas hacer una denuncia?",
    servicio: "Secretaría General",
    contacto: [],
    url: "https://secretariageneral.uc.cl/realiza-una-denuncia",
  },
  {
    tema: "Salud General",
    situacion: "¿Necesitas información sobre servicios de salud mental, dental o física (no urgente)?",
    servicio: "DAE Salud y Bienestar Estudiantil",
    contacto: ["saludybienestar@uc.cl", "Fono: 9-55045700", "@saludybienestaruc"],
    url: "https://asuntosestudiantiles.uc.cl/salud-mental/suspension-academica-por-motivos-de-salud/",
  },
  {
    tema: "Académico",
    situacion: "¿Necesitas información sobre suspensión académica por motivos de salud?",
    servicio: "DAE Salud y Bienestar Estudiantil",
    contacto: ["saludybienestar@uc.cl", "Fono: 9-55045700"],
    url: "https://asuntosestudiantiles.uc.cl/salud-mental/suspension-academica-por-motivos-de-salud/",
  },
  {
    tema: "Académico",
    situacion: "¿Tienes preocupaciones por tu rendimiento académico o vocación profesional?",
    servicio: "CARA — Centro de Apoyo al Rendimiento Académico",
    contacto: ["cara@uc.cl", "Fono: 955047582", "Edificio Aulas Lassen, Subterráneo", "@desarrolloestudiantiluc"],
    url: "https://asuntosestudiantiles.uc.cl/cara",
  },
  {
    tema: "Socioeconómico",
    situacion: "¿Necesitas apoyo en becas, créditos, gratuidad o residencias?",
    servicio: "DASE — Depto. de Asistencia Socioeconómica",
    contacto: ["atencionintegrada@uc.cl", "matricula@uc.cl", "Lun–Jue 8:30–16:30 / Vie hasta 15:00"],
    url: "https://admision.uc.cl/financiamiento-y-matricula/financiamiento-y-matricula-de-estudiantes-regulares/",
  },
  {
    tema: "Bienestar",
    situacion: "¿Necesitas apoyo espiritual?",
    servicio: "Pastoral UC",
    contacto: ["pastoraluc@uc.cl", "+569 5504 4749", "Casa Central: Alameda 340, of. 10"],
    url: "https://pastoral.uc.cl/",
  },
  {
    tema: "Académico",
    situacion: "¿Necesitas apoyo relacionado con discapacidad?",
    servicio: "Dirección de Inclusión — PIANE",
    contacto: ["+56 9 55047655", "Edificio Pataguas, Campus San Joaquín"],
    url: "https://inclusion.uc.cl/piane-uc/",
  },
  {
    tema: "Bienestar",
    situacion: "¿Necesitas información sobre el uso del nombre social en la UC?",
    servicio: "Dirección de Inclusión",
    contacto: ["generoeinclusion@uc.cl"],
    url: "https://inclusion.uc.cl/",
  },
  {
    tema: "Académico",
    situacion: "¿Necesitas información sobre suspensión reglamentaria, anulación, renuncias o reintegros?",
    servicio: "Registros Académicos",
    contacto: ["atencionintegrada@uc.cl", "matricula@uc.cl", "Lun–Jue 8:30–16:30 / Vie hasta 15:00"],
    url: "https://registrosacademicos.uc.cl/informacion-para-estudiantes/",
  },
];

const allItems = [...urgentes.map(i => ({ ...i, urgente: true })), ...otras.map(i => ({ ...i, urgente: false }))];
const temas = [...new Set(allItems.map(i => i.tema))];
---

<Layout title="Canal Único de Ayuda" description="Encuentra el servicio de apoyo que necesitas en la UC.">

  <!-- Header -->
  <section class="py-16 px-4 text-white text-center" style="background: linear-gradient(135deg, #364FAB 0%, #8452B1 100%);">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-3xl md:text-5xl font-bold mb-4">Canal Único de Ayuda</h1>
      <p class="text-white/80 text-lg">Encuentra el servicio de apoyo que necesitas en la UC.</p>
    </div>
  </section>

  <!-- Option switcher -->
  <div class="sticky top-16 z-40 bg-white border-b border-gray-100 shadow-sm">
    <div class="max-w-4xl mx-auto px-4">
      <div class="flex gap-1 py-2">
        {["A", "B", "C"].map((opt, i) => (
          <button
            data-option={opt}
            class={`option-btn px-4 py-2 rounded-lg text-sm font-semibold transition-all ${i === 0 ? "text-white" : "text-gray-500 hover:text-gray-700 hover:bg-gray-50"}`}
            style={i === 0 ? "background: #364FAB;" : ""}
          >
            Opción {opt}
            <span class="ml-1 text-xs font-normal opacity-70">
              {opt === "A" ? "Acordeón" : opt === "B" ? "Todo visible" : "Filtros"}
            </span>
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- ── OPCIÓN A: Accordion ── -->
  <div id="opt-A" class="max-w-4xl mx-auto px-4 py-12 space-y-12">

    {[{ label: "Situaciones urgentes", items: urgentes, accent: "#EF4444" }, { label: "Otras necesidades", items: otras, accent: "#364FAB" }].map(({ label, items, accent }) => (
      <section>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-1 h-8 rounded-full" style={`background: ${accent};`}></div>
          <h2 class="text-xl font-bold" style={`color: ${accent};`}>{label}</h2>
        </div>
        <div class="space-y-3">
          {items.map(({ tema, situacion, servicio, contacto, url }) => {
            const color = temaColor[tema] ?? "#6B7280";
            return (
              <details class="group rounded-2xl border border-gray-100 bg-white shadow-sm overflow-hidden">
                <summary class="flex items-center gap-4 p-5 cursor-pointer list-none hover:bg-gray-50 transition-colors">
                  <span class="flex-shrink-0 px-2 py-0.5 rounded-full text-xs font-semibold text-white" style={`background: ${color};`}>{tema}</span>
                  <span class="flex-1 text-gray-700 text-sm font-medium">{situacion}</span>
                  <svg class="flex-shrink-0 h-4 w-4 text-gray-400 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </summary>
                <div class="px-5 pb-5 border-t border-gray-100 pt-4">
                  <p class="font-semibold text-gray-800 mb-2">{servicio}</p>
                  {contacto.length > 0 && (
                    <ul class="space-y-1 mb-3">
                      {contacto.map(c => <li class="text-sm text-gray-500">{c}</li>)}
                    </ul>
                  )}
                  <a href={url} target="_blank" rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 text-xs font-semibold hover:underline"
                    style={`color: ${color};`}>
                    Ver más
                    <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                  </a>
                </div>
              </details>
            );
          })}
        </div>
      </section>
    ))}
  </div>

  <!-- ── OPCIÓN B: Todo visible ── -->
  <div id="opt-B" class="hidden max-w-4xl mx-auto px-4 py-12 space-y-12">

    {[{ label: "Situaciones urgentes", items: urgentes, accent: "#EF4444" }, { label: "Otras necesidades", items: otras, accent: "#364FAB" }].map(({ label, items, accent }) => (
      <section>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-1 h-8 rounded-full" style={`background: ${accent};`}></div>
          <h2 class="text-xl font-bold" style={`color: ${accent};`}>{label}</h2>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          {items.map(({ tema, situacion, servicio, contacto, url }) => {
            const color = temaColor[tema] ?? "#6B7280";
            return (
              <a href={url} target="_blank" rel="noopener noreferrer"
                class="group flex flex-col rounded-2xl border border-gray-100 bg-white shadow-sm p-5 hover:shadow-md hover:-translate-y-0.5 transition-all">
                <span class="self-start px-2 py-0.5 rounded-full text-xs font-semibold text-white mb-3" style={`background: ${color};`}>{tema}</span>
                <p class="text-sm text-gray-600 leading-relaxed mb-3 flex-1">{situacion}</p>
                <p class="font-semibold text-gray-800 text-sm mb-2">{servicio}</p>
                {contacto.length > 0 && (
                  <ul class="space-y-0.5">
                    {contacto.map(c => <li class="text-xs text-gray-400">{c}</li>)}
                  </ul>
                )}
                <span class="mt-3 text-xs font-semibold flex items-center gap-1" style={`color: ${color};`}>
                  Ver más
                  <svg class="h-3 w-3 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </span>
              </a>
            );
          })}
        </div>
      </section>
    ))}
  </div>

  <!-- ── OPCIÓN C: Filtros ── -->
  <div id="opt-C" class="hidden max-w-4xl mx-auto px-4 py-12">

    <!-- Filter buttons -->
    <div class="flex flex-wrap gap-2 mb-8">
      <button data-filter="all"
        class="filter-btn px-3 py-1.5 rounded-full text-xs font-semibold text-white transition-all"
        style="background: #364FAB;">
        Todos
      </button>
      {temas.map(tema => {
        const color = temaColor[tema] ?? "#6B7280";
        return (
          <button data-filter={tema}
            class="filter-btn px-3 py-1.5 rounded-full text-xs font-semibold border transition-all"
            style={`color: ${color}; border-color: ${color};`}>
            {tema}
          </button>
        );
      })}
    </div>

    <!-- All cards, filterable -->
    <div class="grid sm:grid-cols-2 gap-4" id="card-grid">
      {allItems.map(({ tema, situacion, servicio, contacto, url, urgente }) => {
        const color = temaColor[tema] ?? "#6B7280";
        return (
          <a href={url} target="_blank" rel="noopener noreferrer"
            data-tema={tema}
            class="filter-card group flex flex-col rounded-2xl border border-gray-100 bg-white shadow-sm p-5 hover:shadow-md hover:-translate-y-0.5 transition-all">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-2 py-0.5 rounded-full text-xs font-semibold text-white" style={`background: ${color};`}>{tema}</span>
              {urgente && <span class="px-2 py-0.5 rounded-full text-xs font-semibold text-white" style="background: #EF4444;">Urgente</span>}
            </div>
            <p class="text-sm text-gray-600 leading-relaxed mb-3 flex-1">{situacion}</p>
            <p class="font-semibold text-gray-800 text-sm mb-2">{servicio}</p>
            {contacto.length > 0 && (
              <ul class="space-y-0.5">
                {contacto.map(c => <li class="text-xs text-gray-400">{c}</li>)}
              </ul>
            )}
            <span class="mt-3 text-xs font-semibold flex items-center gap-1" style={`color: ${color};`}>
              Ver más
              <svg class="h-3 w-3 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          </a>
        );
      })}
    </div>
  </div>

  <script>
    // Option switcher
    document.querySelectorAll<HTMLElement>("[data-option]").forEach(btn => {
      btn.addEventListener("click", () => {
        const opt = btn.dataset.option!;
        ["A", "B", "C"].forEach(o => {
          const panel = document.getElementById(`opt-${o}`);
          const b = document.querySelector<HTMLElement>(`[data-option="${o}"]`)!;
          if (o === opt) {
            panel?.classList.remove("hidden");
            b.style.background = "#364FAB";
            b.classList.remove("text-gray-500");
            b.classList.add("text-white");
          } else {
            panel?.classList.add("hidden");
            b.style.background = "";
            b.classList.add("text-gray-500");
            b.classList.remove("text-white");
          }
        });
      });
    });

    // Filter buttons
    document.querySelectorAll<HTMLElement>(".filter-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const tema = btn.dataset.filter!;
        document.querySelectorAll<HTMLElement>(".filter-card").forEach(card => {
          card.style.display = (tema === "all" || card.dataset.tema === tema) ? "" : "none";
        });
        document.querySelectorAll<HTMLElement>(".filter-btn").forEach(b => {
          const active = b.dataset.filter === tema;
          b.style.background = active ? "#364FAB" : "";
          b.style.color = active ? "white" : "";
          b.style.borderColor = active ? "#364FAB" : "";
        });
      });
    });
  </script>

</Layout>
