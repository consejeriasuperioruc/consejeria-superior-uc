---

<Layout title="Representación" description="Conoce las consejerías académicas de cada carrera UC y sus representantes.">

  <!-- Header -->
  <section class="py-16 px-4 text-white text-center" style="background: linear-gradient(135deg, #364FAB 0%, #8452B1 100%);">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-3xl md:text-5xl font-bold mb-4">Representación</h1>
      <p class="text-white/80 text-lg">Consejerías académicas de cada carrera UC y sus representantes 2026.</p>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 py-12">

    <!-- Search -->
    <div class="mb-8">
      <input
        id="search-carrera"
        type="text"
        placeholder="Buscar carrera..."
        class="w-full max-w-sm px-4 py-2 rounded-xl border border-gray-200 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-300"
      />
    </div>

    <!-- Cards grid -->
    <div id="carreras-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {carreras.map(({ carrera, instagram, consejeria, subconsejeria }) => (
        <div
          class="carrera-card flex flex-col gap-3 px-4 py-4 rounded-2xl border border-gray-100 shadow-sm bg-white hover:shadow-md transition-shadow"
          data-carrera={carrera.toLowerCase()}
        >
          <!-- Career name -->
          <p class="text-sm font-bold text-gray-800 leading-snug">{carrera}</p>

          <!-- Consejeros -->
          {consejeria && (
            <div class="flex flex-col gap-1 text-xs text-gray-500">
              <div class="flex items-start gap-1.5">
                <span class="mt-0.5 shrink-0 w-4 h-4 rounded-full flex items-center justify-center text-white text-[9px] font-bold" style="background: #364FAB;">C</span>
                <span>{consejeria}</span>
              </div>
              {subconsejeria && (
                <div class="flex items-start gap-1.5">
                  <span class="mt-0.5 shrink-0 w-4 h-4 rounded-full flex items-center justify-center text-white text-[9px] font-bold" style="background: #8452B1;">S</span>
                  <span>{subconsejeria}</span>
                </div>
              )}
            </div>
          )}

          <!-- Instagram -->
          <a
            href={`https://instagram.com/${instagram}`}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-auto self-start flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-lg transition-colors hover:opacity-80"
            style="color: #8452B1; background: #F5EFF9;"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
            @{instagram}
          </a>
        </div>
      ))}
    </div>

    <p id="no-results" class="hidden text-center text-gray-400 text-sm py-8">No se encontraron resultados.</p>

  </div>
</Layout>

<script>
  const searchInput = document.getElementById("search-carrera") as HTMLInputElement;
  const cards = document.querySelectorAll<HTMLElement>(".carrera-card");
  const noResults = document.getElementById("no-results");

  searchInput?.addEventListener("input", () => {
    const q = searchInput.value.toLowerCase().trim();
    let visible = 0;
    cards.forEach((card) => {
      const match = !q || card.dataset.carrera!.includes(q);
      card.classList.toggle("hidden", !match);
      if (match) visible++;
    });
    noResults?.classList.toggle("hidden", visible > 0);
  });
</script>
